# Global Claude Patterns Repository - .gitignore

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor Files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary Files
*.tmp
*.bak
*.log

# Local Testing
test-project/
sandbox/
scratch/

# Build Artifacts (if any scripts generate them)
*.pyc
__pycache__/
node_modules/

# Local Configuration (if users want to override)
local-config.yml
# Tooling dependencies
tooling/node_modules/
tooling/package-lock.json
.grantflow

# knowledge-retriever (RAG) runtime artifacts — NEVER commit (186MB+ Qdrant storage, deps, builds)
mcp-server/knowledge-retriever/node_modules/
mcp-server/knowledge-retriever/dist/
mcp-server/knowledge-retriever/volumes/qdrant/
mcp-server/knowledge-retriever/.knowledge/

# Stan drzewa przy ostatnim reseedzie RAG — lokalny dla maszyny (Qdrant stoi lokalnie),
# nie dla repozytorium. Zapisywany przez scripts/reseed-patterns.sh.
.rag-seed-state.json

# Wyniki evala retrievalu — artefakt runtime z tests/flow-evals/retrieval/run.js,
# nadpisywany przy każdym uruchomieniu (m.in. z scripts/reseed-patterns.sh).
tests/flow-evals/retrieval/results.jsonl

# Lokalne nadpisania uprawnień/hooków tego repo jako projektu — nie dla współpracowników.
# (globalny ~/.config/git/ignore chroni to na tej maszynie, ale nie na innych)
.claude/settings.local.json
