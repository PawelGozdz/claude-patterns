{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-patterns/telemetry-event-v1",
  "title": "Zdarzenie telemetrii przebiegu v1 (ADR 0012)",
  "description": "Kontrakt zapisu (scripts/lib/telemetry-events.mjs) i przyszłego transportu na serwer. Zdarzenie NIE zawiera treści promptów, powodów ze skrzynki, ścieżek plików ani konfiguracji projektu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "ts", "kind", "process", "project", "host", "runId"],
  "allOf": [
    {
      "description": "review-panel (ADR 0012, aneks TASK-GSTACK-ADOPT-001): jedno step.end na reviewera w przebiegu panelu, bez pomiarów i pól innych procesów (m, cause, taskRef, engine, plan, signature, trigger, seed oraz step.group/agent/model/attempt/fixes/blamed/unblamed są zabronione). step.id = step.role = nazwa reviewera bez prefiksu reviewer- (np. nitpicker); outcome ok = reviewer się wykonał (wtedy step.findings jest obowiązkowe), skipped = adaptacyjnie pominięty (findings zabronione).",
      "if": { "required": ["process"], "properties": { "process": { "const": "review-panel" } } },
      "then": {
        "required": ["step", "outcome"],
        "not": { "anyOf": [{ "required": ["cause"] }, { "required": ["m"] }, { "required": ["signature"] }, { "required": ["trigger"] }, { "required": ["seed"] }, { "required": ["plan"] }, { "required": ["engine"] }, { "required": ["taskRef"] }] },
        "properties": {
          "kind": { "const": "step.end" },
          "outcome": { "enum": ["ok", "skipped"] },
          "step": {
            "description": "x-equalProperties to słowo kluczowe lokalnego walidatora (scripts/lib/telemetry-events.mjs): id i role muszą być tą samą nazwą. Zwykły walidator JSON Schema je pomija.",
            "required": ["id", "role"],
            "x-equalProperties": ["id", "role"],
            "not": { "anyOf": [{ "required": ["group"] }, { "required": ["agent"] }, { "required": ["model"] }, { "required": ["attempt"] }, { "required": ["fixes"] }, { "required": ["blamed"] }, { "required": ["unblamed"] }] },
            "properties": {
              "id": { "pattern": "^[a-z][a-z0-9-]{0,40}$" },
              "role": { "pattern": "^[a-z][a-z0-9-]{0,40}$" }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["process", "outcome"], "properties": { "process": { "const": "review-panel" }, "outcome": { "const": "ok" } } },
      "then": { "required": ["step"], "properties": { "step": { "required": ["findings"] } } }
    },
    {
      "if": { "required": ["process", "outcome"], "properties": { "process": { "const": "review-panel" }, "outcome": { "const": "skipped" } } },
      "then": { "properties": { "step": { "not": { "required": ["findings"] } } } }
    },
    {
      "description": "step.findings istnieje wyłącznie w zdarzeniach review-panel — inne procesy nie mają jak przemycić licznika.",
      "if": { "required": ["step"], "properties": { "step": { "required": ["findings"] } } },
      "then": { "properties": { "process": { "const": "review-panel" } } }
    }
  ],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "ts": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["run.start", "step.end", "run.end", "deviation", "seed"] },
    "process": { "enum": ["orchestrate", "workflow", "analyze", "audit", "setup", "blog-seed", "pre-commit", "hook", "review-panel"] },
    "project": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,80}$" },
    "host": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$" },
    "taskRef": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]{1,80}$" },
    "engine": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "group": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "group": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "agent": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "attempt": { "type": ["integer", "null"], "minimum": 1 },
        "fixes": { "type": ["string", "null"] },
        "blamed": {
          "description": "Tylko pierwszy krok bramki końcowej przebiegu (TASK-OBS-012): id warstw, których pliki wskazują naruszenia bramki. Pole obecne (nawet puste) = przypisanie wykonano. Bez ścieżek i treści naruszeń.",
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "maxItems": 64
        },
        "unblamed": {
          "description": "Liczba naruszeń bramki, których nie da się przypisać do warstwy (dokument, luka w sprawdzeniu, przyczyna maszynowa).",
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "description": "Tylko process=review-panel, outcome=ok (ADR 0012, aneks TASK-GSTACK-ADOPT-001): liczba findingów zgłoszonych przez reviewera w jednym przebiegu panelu. Sama liczba — bez treści, ścieżek i autorów findingów.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outcome": { "enum": ["ok", "go", "no_go", "fixed", "failed", "died", "skipped", "cached", "halted", "killed", "unknown"] },
    "cause": { "enum": ["typecheck", "test", "lint", "verifier", "scope", "config", "infra", "silent", "budget", "pattern_card", "plan", "other", null] },
    "signature": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]{1,120}$" },
    "trigger": { "type": ["string", "null"] },
    "seed": {
      "description": "Zalążek wpisu (ADR 0013). WYŁĄCZNIE kody — bez tematu, sluga i uzasadnienia.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "enum": ["emitted", "updated", "suppressed", "status-changed", "checked", "skipped"] },
        "seedId": { "type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$" },
        "dedup": { "type": ["string", "null"], "pattern": "^[0-9a-f]{12}$" },
        "blog": { "enum": ["personal", "product", null] },
        "reason": { "enum": ["security", "evidence", "consent", "duplicate", "routing", "rate", "score", "config", "disabled", "embargo", "invalid", "error", "no_topic", null] },
        "confidence": { "enum": ["high", "medium", "low", null] },
        "mode": { "enum": ["dry-run", "live", null] },
        "status": { "enum": ["new", "candidate", "picked", "drafted", "published", "discarded", "merged", null] }
      }
    },
    "m": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolCalls": { "type": ["integer", "null"], "minimum": 0 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "tokensIn": { "type": ["integer", "null"], "minimum": 0 },
        "tokensOut": { "type": ["integer", "null"], "minimum": 0 },
        "cacheRead": { "type": ["integer", "null"], "minimum": 0 },
        "cacheWrite": { "type": ["integer", "null"], "minimum": 0 },
        "costUsd": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
