{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(.env.example)",
      "Read(.env.sample)",
      "Read(.env.template)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(curl --upload:*)",
      "Bash(wget --post:*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "worktree": {
    "symlinkDirectories": [".venv", "venv", "__pycache__", "models_cache"]
  },
  "autoMode": {
    "environment": [
      "Python ML inference service — FastAPI + PyTorch on a shared GPU.",
      "routers/ must not import torch or model libraries; models/ must not import fastapi.",
      "Every inference call inside async def must go through asyncio.to_thread.",
      "Model loading and unloading belongs to the lifecycle manager only.",
      "GPU memory is shared with other processes — check free VRAM before loading.",
      "Use type annotations on all public functions."
    ],
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(pytest *)",
      "Bash(python -m mypy *)",
      "Bash(ruff check *)",
      "Bash(nvidia-smi *)",
      "Bash(nvidia-smi)",
      "Bash(curl -s localhost:*/v1/health*)",
      "Bash(curl -s localhost:*/v1/metrics*)"
    ],
    "soft_deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(ollama rm *)",
      "Bash(ollama stop *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-gpu-patterns.js\""
          }
        ],
        "description": "GPU: blocking inference in async def, empty_cache without gc.collect, gather fan-out"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-python-layers.js\""
          }
        ],
        "description": "Python: routers/ must not import torch or model libraries"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-python-typing.js\""
          }
        ],
        "description": "Python: missing return type annotations"
      }
    ]
  }
}
