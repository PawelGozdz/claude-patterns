{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(.env.example)",
      "Read(.env.sample)",
      "Read(.env.template)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(curl --upload:*)",
      "Bash(wget --post:*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "worktree": {
    "symlinkDirectories": [".dart_tool", "build"]
  },
  "autoMode": {
    "environment": [
      "Flutter mobile application with clean architecture.",
      "Domain layer must remain pure (no framework imports).",
      "Use Riverpod for state management.",
      "Follow feature-first folder structure."
    ],
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(flutter test *)",
      "Bash(flutter analyze *)",
      "Bash(dart format *)"
    ],
    "soft_deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-clean-arch.js\""
          }
        ],
        "description": "Flutter: domain/application layer purity"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-riverpod-patterns.js\""
          }
        ],
        "description": "Flutter: Riverpod ref.read() inside build() detection"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-design-tokens.js\""
          }
        ],
        "description": "Flutter: visual literals used instead of design tokens (K43, TASK-KAIZEN-001)"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-typography-tokens.js\""
          }
        ],
        "description": "Flutter: inline TextStyle(fontSize:...)/EdgeInsets.*() literals (K43, TASK-KAIZEN-001)"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-l10n-hardcoded.js\""
          }
        ],
        "description": "Flutter: hardcoded UI text instead of localization keys (K43, TASK-KAIZEN-001)"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-focus-wrapper.js\""
          }
        ],
        "description": "Flutter: bare GestureDetector without Focus/SoftPressable wrapper (WCAG 2.4.7)"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-debugprint-guard.js\""
          }
        ],
        "description": "Flutter: debugPrint()/print() without kDebugMode guard (K43, TASK-KAIZEN-001)"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/check-flutter-imports.js\""
          }
        ],
        "description": "Detect cross-feature imports in Dart files"
      }
    ]
  }
}
