{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/block-root-grep.js\""
          }
        ],
        "description": "Deny recursive grep/rg/git grep over the repo root (Read(.env) deny rule would stall the flow with a permission prompt). Scoped searches and the Grep tool pass."
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pre-workflow-lint.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-start-pm.js\""
          }
        ],
        "description": "Auto-load TEAM-STATE.md for projects with PM-system (silent if absent)"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/workflow-metrics-postrun.js\""
          }
        ],
        "description": "Workflow metrics: fire-and-forget collector of per-step metrics to ~/.claude/metrics/workflow-steps.jsonl (TASK-OBS-002)"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pr-url-logger.js\""
          }
        ],
        "description": "Log PR URL after creation"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pm-task-housekeeping.js\""
          }
        ],
        "description": "Auto-move task files to completed-tasks/ when status: done. Disable via PM_NO_AUTO_HOUSEKEEPING=true. Silent on non-task files."
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/security-impl-feedback.js\""
          }
        ],
        "description": "Show security checklist progress when editing .ts source files. Disable via AGENT_SECURITY_IMPL_FEEDBACK=off. Silent for non-source or no-active-task."
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/subagent-start-log.js\"",
            "async": true
          }
        ],
        "description": "Log subagent start for cost monitoring"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/subagent-stop-log.js\"",
            "async": true
          }
        ],
        "description": "Log subagent stop for cost monitoring"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/subagent-stop-cost-log.js\"",
            "async": true
          }
        ],
        "description": "Append per-agent token usage to ~/.claude/logs/agent-usage.jsonl. Disable with AGENT_USAGE_LOG=off."
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/agent-memory-size-guard.js\"",
            "async": true
          }
        ],
        "description": "Warn (stderr, non-blocking) when an agent's .claude/agent-memory/<agent>/ looks like a run log: MEMORY.md > 4 KB, > 20 notes, task-status file names, or > 40 KB total. Disable with AGENT_MEMORY_SIZE_GUARD=off."
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/worktree-env-copy.js\""
          }
        ],
        "description": "Copy .env files to worktree on creation"
      }
    ]
  }
}
